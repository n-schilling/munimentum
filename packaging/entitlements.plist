<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Exceptions from the hardened runtime. Notarization only works with it, and
  it switches off what CPython needs – without these three lines the signed
  app no longer starts (see packaging/signing.md, step 4).

  Deliberately as little as possible: whoever can remove a line without the
  app dying at launch should do so. Console.app names the reason on a failed
  attempt.
-->
<plist version="1.0">
<dict>
  <!-- CPython creates executable memory at runtime (ctypes, libffi). -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- PyInstaller loads over 200 .so/.dylib from the unpacked bundle. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
