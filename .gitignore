# Zugangsdaten. gx_token.txt ist der eingefügte Schlüssel, msal_cache.bin der
# Refresh-Token aus der Anmeldung – letzterer entsteht erst beim ersten
# Anmelden und wäre sonst weder ignoriert noch bemerkt worden.
gx_token.txt
msal_cache.bin

# Signierschlüssel für macOS (siehe packaging/signieren.md). Sie gehören in die
# GitHub-Secrets, nie ins Repository – ein öffentlich gewordener privater
# Schlüssel lässt sich nur durch Widerrufen des Zertifikats reparieren.
*.p12
*.p8
*.mobileprovision

# Laufzeitdaten eines Quell-Laufs – der Heimatordner ist dann das Projekt.
# data/ hält seit dem Ablage-Split alle Exporte; die einzelnen Ordnernamen
# bleiben als Netz für Arbeitsstände von davor.
data/
rag_store/
teams_export/
outlook_export/
onedrive_export/
sharepoint_export/
sharepoint_pages/
planner_export/
app_config.json
runs.db
app.log
datenordner.txt

# Werkzeug- und Systemreste
__pycache__/
.pytest_cache/
.ruff_cache/
.claude/
.coverage
.DS_Store
build/
dist/
