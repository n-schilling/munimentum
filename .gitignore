# Credentials. gx_token.txt is the pasted access key, msal_cache.bin the
# refresh token from signing in – the latter only appears after the first
# sign-in and would otherwise be neither ignored nor noticed.
gx_token.txt
msal_cache.bin

# macOS signing keys (see packaging/signieren.md). They belong in the GitHub
# secrets, never in the repository – a leaked private key can only be fixed
# by revoking the certificate.
*.p12
*.p8
*.mobileprovision

# Runtime data of a source run – the app's home folder is the project then.
# data/ holds every export since the storage split; the individual folder
# names remain as a net for working states from before.
data/
rag_store/
teams_export/
outlook_export/
onedrive_export/
sharepoint_export/
sharepoint_pages/
planner_export/
app_config.json
runs.db
app.log
datenordner.txt

# Tool and system residue
__pycache__/
.pytest_cache/
.ruff_cache/
.claude/
.coverage
.DS_Store
build/
dist/
