# Credentials. gx_token.txt is the pasted access key, msal_cache.bin the
# refresh token from signing in – the latter only appears after the first
# sign-in and would otherwise be neither ignored nor noticed.
gx_token.txt
msal_cache.bin

# macOS signing keys (see packaging/signieren.md). They belong in the GitHub
# secrets, never in the repository – a leaked private key can only be fixed
# by revoking the certificate.
*.p12
*.p8
*.mobileprovision

# Runtime data of a source run – the app's home folder is the project then.
# data/ holds the exports of a fresh layout; the individual names stay
# because an upgraded checkout keeps its flat folders and the app pins the
# data folder to the home folder for it (altbestand_pinnen) – real mail
# would otherwise sit unignored in the working copy.
data/
rag_store/
teams_export/
outlook_export/
onedrive_export/
sharepoint_export/
sharepoint_pages/
planner_export/
app_config.json
runs.db
app.log

# Tool and system residue
__pycache__/
.pytest_cache/
.ruff_cache/
.claude/
.coverage
.DS_Store
build/
dist/
